// Minimal mirror of the Riksdagen web app's Quote table.
// The web repo owns that schema and its migrations (Riksdagen/prisma/schema.prisma);
// keep this model in sync. The PROD bot deployment injects quotes into BOTH the
// prod and dev web databases over LAN (see src/quotes/web-sync.ts); the dev bot
// deployment configures no web databases and injects nothing.
generator client {
  provider = "prisma-client"
  moduleFormat = "esm"
  output   = "../src/lib/prisma-web/generated"
}

datasource db {
  provider = "mysql"
}

model Quote {
  id               String   @id // Discord message ID
  authorId         String
  createdTimestamp BigInt // ms epoch
  link             String
  originalLink     String?

  sender String
  body   String @db.Text
  quotee String

  quoteeId    String?
  context     String? @db.Text
  attachments Json?

  @@index([createdTimestamp])
}
