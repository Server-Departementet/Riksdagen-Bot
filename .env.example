# Connection string to the bot's OWN MariaDB database (User + Quote tables),
# local to the bot container.
DATABASE_URL="mysql://user:password@localhost:3306/riksdagen_bot"

# Web databases that receive a copy of the Quote table over LAN (src/quotes/web-sync.ts).
# The PROD bot deployment (main branch) sets BOTH; the dev bot deployment sets
# neither. Unset URLs are skipped.
WEB_DATABASE_URL_PROD=""
WEB_DATABASE_URL_DEV=""

# Port for the asset server (systemd/assets.service) serving public/quote-attachments
# to the web VMs. Optional, defaults to 3100.
ASSETS_PORT="3100"

# Discord bot credentials
DISCORD_BOT_TOKEN=""
DISCORD_BOT_CLIENT_ID=""

# Regeringen guild + channels
REGERINGEN_GUILD_ID=""
QUOTE_CHANNEL_ID=""
QUIZ_CHANNEL_ID=""

# Public base URL used to build attachment image links in quiz embeds
CANONICAL_URL="https://riksdagen.net"

# Discgolf bot guild + channels
DISCGOLF_GUILD_ID=""
DISCGOLF_READ_CHANNEL_ID=""
DISCGOLF_WRITE_CHANNEL_ID=""
DISCGOLF_RECORD_CHANNEL_ID=""
DISCGOLF_RECORD_MESSAGE_ID=""
